classDiagram
    %% ===== 新增：控制台服务端 =====
    class ConsoleApi {
        +handle(req, res, url, ctx)
        -dispatchLogin()
        -dispatchStatus()
        -dispatchOrders()
        -dispatchGrant()
        -dispatchVars()
        -dispatchAdmins()
        -dispatchDevices()
        -dispatchPrinters()
        -dispatchConsoleAudit()
    }

    class ConsoleAuth {
        -sessions: Map~sessionId,Session~
        +loginConsole(mode, token, qq) Session
        +verifyAuth(req, minLevel) AuthResult
        -issueSession(qq, level, scope) string
        -isSuper(req) bool
    }
    class Session {
        +qq: string
        +level: int
        +scope: 'super'|'admin'|'viewer'
        +createdAt: int
        +expiresAt: int
    }

    class ConsoleAudit {
        +logAction(entry)
        +listAudit(opts) Array
    }

    class PermissionBridge {
        <<server侧 N4 客户端>>
        +readSnapshot() Snapshot
        +verifyL2Plus(uin) bool
        +hasAccess(uin) bool
        +enqueueAdminCommand(cmd)
        +listAudits() Array
        -snapshotPath: string
        -inboxPath: string
    }
    class Snapshot {
        +admins: AdminEntry[]
        +audits: AuditRow[]
        +meta: {superAdmin, developer, exportedAt}
    }

    class DeviceService {
        +listDevices(store) Device[]
        +disableDevice(store, machineId) Result
        +resetDevice(store, machineId, qq) Result
        +restartDevice() Result
    }
    class Device {
        +machine_id: string
        +qq: string
        +code: string
        +plan: string
        +status: 'normal'|'revoked'|'trial'|'offline'|'anomaly'
        +last_heartbeat: {at, valid, reason}
        +license_expires_at: int
    }

    class PrinterService {
        <<CUPS via child_process>>
        +listPrinters() Printer[]
        +addPrinter(spec) Result
        +printerAction(name, action) Result
        -execLpstat() string
        -execLpadmin(args) Result
    }
    class Printer {
        +name: string
        +enabled: bool
        +accepting: bool
        +status: string
        +deviceUri: string
        +isDefault: bool
    }

    class RuntimeService {
        +getStatus(ctx) Status
        -cpuBusyPct() number
        -diskUsage(path) object
        -pm2Processes() object
    }
    class Status {
        +health: string
        +uptimeSec: int
        +memory: object
        +cpu: object
        +disk: object
        +processes: object
        +modules: object
        +stats: object
    }

    class OrderConsoleService {
        +listOrdersRich(store, cfg) Order[]
        +grantMember(store, keys, cfg, order_id) Result
    }

    class ConfigConsoleService {
        <<封装 configManager>>
        +readVars(cfg, store) VarsView
        +writeVars(opts) Result
    }

    %% ===== 复用：现有模块（不重写）=====
    class Store {
        <<现有 activation-server>>
        +listLicenses()
        +listHeartbeats()
        +getCode() / updateCode()
        +getOrder() / listOrders()
        +saveTrial() / getTrial()
        +updateTrialUser()
    }
    class ConfigManager {
        <<现有 23 项配置中心>>
        +readConfig(cfg, store)
        +writeConfig(opts)
        +SCHEMA
    }
    class PermissionServiceBot {
        <<bot 侧 N4，仅被 bridge 间接使用>>
        +setLevel/removeLevel/listUsers
    }
    class LicenseGate {
        <<bot 侧，设备降级由心跳驱动>>
    }

    %% ===== 关系 =====
    ConsoleApi ..> ConsoleAuth : 鉴权
    ConsoleApi ..> ConsoleAudit : 审计
    ConsoleApi ..> PermissionBridge : 管理员/登录校验
    ConsoleApi ..> DeviceService : 设备
    ConsoleApi ..> PrinterService : 打印机
    ConsoleApi ..> RuntimeService : 状态
    ConsoleApi ..> OrderConsoleService : 订单/开通
    ConsoleApi ..> ConfigConsoleService : 变量

    DeviceService ..> Store : 读写
    OrderConsoleService ..> Store : 读
    OrderConsoleService ..> LicenseGate : 复用签发逻辑(同进程)
    ConfigConsoleService ..> ConfigManager : 复用
    RuntimeService ..> Store : 统计

    PermissionBridge ..> Snapshot : 读文件
    PermissionBridge ..> PermissionServiceBot : 经 bot 桥接写
    PrinterService ..> child_process : lpstat/lpadmin
    DeviceService ..> child_process : pm2 restart

    note for PermissionBridge "server 侧仅 fs 读快照 / 追加命令；\n写经由 bot 侧 bridge 应用"
    note for PrinterService "同机 CUPS，child_process 直调"
