# sea1-activation-server/config.env — 激活服务配置（由 install.sh 渲染生成）
# 支付宝当面付密钥（可选，PAYMENT_MODE=auto 时必填；manual 模式可留空后补）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# token（部署时随机生成，与 sea2-bot license 对象一致）
MONITOR_TOKEN=__MONITOR_TOKEN__
WEBHOOK_SECRET=__WEBHOOK_SECRET__
BOT_NOTIFY_TOKEN=__BOT_NOTIFY_TOKEN__
BOT_NOTIFY_URL=http://127.0.0.1:13008/vip/notify-paid
OPS_TOKEN=__SEA2_OPS_TOKEN__

# 试用/授权
TRIAL_MONTHS="12"
TRIAL_DISABLED=""
TRIAL_DAYS="14"
GRACE_DAYS="7"
TRIAL_NEAR_DAYS="7,3,1"
TRIAL_MAX_REMINDERS="3"

# 服务
PORT="3457"
HOST="0.0.0.0"
DATA_DIR="/root/sea1-activation-server/data"
PAYMENT_MODE="manual"
PLANS_JSON='{"month":{"id":"month","name":"月度会员","price":5,"durationDays":30,"features":["*"]},"quarter":{"id":"quarter","name":"季度会员","price":12,"durationDays":90,"features":["*"]},"year":{"id":"year","name":"年度会员","price":48,"durationDays":365,"features":["*"]},"lifetime":{"id":"lifetime","name":"永久授权","price":128,"durationDays":0,"features":["*"]}}'
PAYMENT_QR_JSON="{}"
PUBLIC_BASE_URL=""
LAN_BYPASS=1

# 部署辅助（可选）
SEA2_DEPLOY_TOKEN=__SEA2_DEPLOY_TOKEN__
SEA2_GIT_TOKEN=
DOCKER_MGR_USER=root
DOCKER_MGR_PASS=__DOCKER_MGR_PASS__
