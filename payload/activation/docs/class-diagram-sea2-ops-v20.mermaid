classDiagram
    %% ===== 增量 v2.0 类图（§10）：中间页登录信息 + 穿透 WebUI + 集群列 + 移动端 + 试用纳入管理 =====

    class QrServer {
        +state.loginInfo Object
        +NAPCAT_HTTP_URL string
        +NAPCAT_HTTP_TOKEN string
        +EXTERNAL_URL string
        +detectLoginInfo() Promise~LoginInfo~
        +proxyAvatar(qq) Promise~{ok,data,type}~
        +buildWebuiUrl() Promise~{ok,url,entryUrl,port,tokenPresent,external}~
        +webuiDiag() Promise~{ok,origin,external,lanIp,webuiPort,tokenPresent,credentialPresent,upstreamReachable}~
        +proxyWebuiRequest(req,res,fullUrl,retried,bodyBuf) Promise
        +mapWebuiPath(p) string
        +injectAutoLogin(buf) Buffer
        +handleUpgrade(req,socket,head) void
    }
    class MiddlePage {
        +poll() void
        +renderAccountCard(li) void
        +openWebui() void
        +copyWebuiUrl() void
        +webuiWhiteScreenHint() void
    }
    class NapCatHttp {
        +get_login_info() Promise~{user_id,nickname}~
        +avatar(qq) Promise~image~
    }
    class NapCatWebui {
        +indexHtml() Buffer
        +api() JSON
        +ws() Stream
    }
    class FleetList {
        +items[] Object
        +pm2Processes Array
        +isTrial boolean
        +includeProcesses boolean
    }
    class FleetApi {
        +listClients(filter) Page
        +clientDetail(mid) Detail
    }
    class FleetStoreSnapshot {
        +pm2Processes Array
        +loginInfo Object
        +isTrial boolean
        +trialInfo Object
        +recordHeartbeat(mid, info) void
    }
    class DevicesService {
        +listDevices(store, fsInst) DerivedDevice[]
        +extendWithProfiles(items, profiles) Items
    }
    class DevicesCrud {
        +_listDevices() MergedDevice[]
        +_getProfile(entity, id) Object
        +_setProfile(entity, id, patch) Object
    }
    class PmConsole {
        +loadClients(force) Clients
        +renderClientProcesses() void
        +renderAllDevicesAggregate() void
    }
    class DeviceConsole {
        +renderDeviceTable() void
        +openAddDevice() void
        +editDeviceProfile(mid) void
    }
    class TunnelLayer {
        +forwardHttp(path) void
        +forwardWs(path) void
    }

    QrServer --> NapCatHttp : get_login_info /avatar
    QrServer --> NapCatWebui : /webui/* /api/* /assets/* proxy
    QrServer --> MiddlePage : /api/status login_info / /api/webui entryUrl
    MiddlePage --> TunnelLayer : location.origin + /webui/ (穿透域名)
    TunnelLayer --> QrServer : 13011 TCP(HTTP+WS)
    FleetApi --> FleetList : includeProcesses=1 → pm2Processes/isTrial
    FleetList --> FleetStoreSnapshot : snapshot.pm2Processes
    DevicesCrud --> DevicesService : _listDevices()
    DevicesService --> FleetStoreSnapshot : fleet 心跳设备自动纳入(含试用)
    DevicesCrud --> DeviceConsole : merged items
    PmConsole --> FleetApi : 全部设备聚合
    FleetApi --> FleetStoreSnapshot : recordHeartbeat(pm2_processes)
